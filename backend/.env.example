# Groq API key — https://console.groq.com (free tier, no card needed)
GROQ_API_KEY=

# Tavily search API key — https://tavily.com (free tier: 1000 searches/month)
TAVILY_API_KEY=

# Model to use for all agent roles.
GROQ_MODEL=llama-3.3-70b-versatile

# Max sub-questions the planner is allowed to generate
MAX_SUBQUESTIONS=5

# Max search results fetched per sub-question
RESULTS_PER_SUBQUESTION=4
